{
  "plugins": ["prettier-plugin-organize-imports", "prettier-plugin-sql"],
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "endOfLine": "lf",
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "semi": true,
  "overrides": [
    {
      "files": "*.sql",
      "options": {
        "printWidth": 120
      }
    }
  ]
}
